              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 6,
                    "hospitalId": 6,
                    "parentId": null,
                    "name": "Intensive Care Unit",
                    "code": "ICU",
                    "note": null
