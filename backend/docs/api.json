{
  "openapi": "3.0.3",
  "info": {
    "title": "We Roster",
    "version": "1.0.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    { "url": "https://api.we-roster.dev/api/v1" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/departments": {
      "get": {
        "operationId": "listDepartments",
        "summary": "List of departments",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 6,
                    "hospitalId": 6,
                    "parentId": null,
                    "name": "Intensive Care Unit",
                    "code": "ICU",
                    "note": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/hospitals": {
      "get": {
        "operationId": "listHospitals",
        "summary": "List of hospitals",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 6,
                    "name": "Royal Melbourne Children's Hospital",
                    "code": "RMCH",
                    "address": "50 Flemington Rd, Parkville VIC 3052",
                    "note": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/locations": {
      "get": {
        "operationId": "listLocations",
        "summary": "List of locations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 7,
                    "hospitalId": 1,
                    "parentId": null,
                    "name": "ICU Bay A",
                    "code": "ICU-A",
                    "type": "Ward",
                    "note": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/designations": {
      "get": {
        "operationId": "listDesignations",
        "summary": "List of designations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 1,
                    "name": "Registered Doctor",
                    "code": "RD",
                    "matrix": "RD-1",
                    "type": "Doctoring",
                    "status": "ACTIVE",
                    "statusTime": "2025-08-28T12:34:56Z",
                    "accreditation": "AHPRA",
                    "note": null,
                    "createdTime": "2025-03-10T09:00:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/staff": {
      "get": {
        "operationId": "listStaff",
        "summary": "List of staff",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 6,
                    "hospitalId": 3,
                    "designationId": 12,
                    "firstName": "Sairus",
                    "lastName": "Pan",
                    "gender": "M",
                    "dateOfBirth": "2004-11-24",
                    "hireDate": "2025-06-06",
                    "leaveDate": null,
                    "email": "sairus.pan@example.com",
                    "phone": "+61 466 948 111",
                    "isManager": true,
                    "type": "PartTime",
                    "matrix": "RN-4",
                    "status": "ACTIVE",
                    "statusTime": "2025-08-28T12:34:56Z",
                    "note": null,
                    "createdTime": "2025-03-10T09:00:00Z",
                    "departments": [
                      { "deptId": 2, "isPrimary": false, "assignedAt": "2025-05-14T09:00:00Z" }
                    ]
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/roster-templates": {
      "get": {
        "operationId": "listRosterTemplates",
        "summary": "List of roster templates",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 6,
                    "status": "ACTIVE",
                    "name": "Template_1",
                    "code": "lkashd",
                    "createdTime": "2024-03-10T09:00:00Z",
                    "note": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/leave-requests": {
      "get": {
        "operationId": "listLeaveRequests",
        "summary": "List of leave requests",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 666,
                    "startTime": "2025-10-02T00:00:00Z",
                    "endTime": "2025-10-08T00:00:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/shift-swaps": {
      "get": {
        "operationId": "listShiftSwaps",
        "summary": "List of shift swaps",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 666,
                    "fromTime": "2025-09-05T08:00:00Z",
                    "toTime": "2025-09-05T16:00:00Z",
                    "dateMade": "2025-09-04T10:00:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List of users",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 42,
                    "role": "ADMIN",
                    "email": "administrator@example.com",
                    "status": "ACTIVE",
                    "createdTime": "2025-04-01T09:00:00Z",
                    "statusTime": "2025-05-28T12:34:56Z",
                    "lastLoginTime": "2025-09-02T08:00:00Z",
                    "loginAttempts": 0
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/open-shifts": {
      "get": {
        "parameters": [
          { "name": "dateFrom", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "dateTo", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "session", "in": "query", "schema": { "type": "string", "enum": ["AM","PM","AH","ON_CALL"] } },
          { "name": "locationId", "in": "query", "schema": { "type": "integer" } },
          { "name": "deptId", "in": "query", "schema": { "type": "integer" } },
          { "name": "roleLike", "in": "query", "schema": { "type": "string" }, "description": "matches shift.code / dept name" },
          { "name": "urgentOnly", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "minExtraPay", "in": "query", "schema": { "type": "integer" }, "description": "cents" },
          { "name": "compareWithMyRoster", "in": "query", "schema": { "type": "boolean", "default": false } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0, "minimum": 0 } }
        ],
        "operationId": "listOpenShifts",
        "summary": "List of open shifts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "shiftId": 601,
                    "dateMade": "2025-09-05T12:00:00Z"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/shifts": {
      "get": {
        "operationId": "listShifts",
        "summary": "List of shifts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } },
                "example": [
                  {
                    "id": 601,
                    "startTs": "2025-09-17T08:00:00Z",
                    "endTs": "2025-09-17T16:00:00Z",
                    "deptId": 6,
                    "locationId": 8,
                    "code": "DAY-8H",
                    "note": "Day shift"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." } } }
          }
        }
      }
    },
    "/my-team": {
      "get": {
        "operationId": "listMyTeam",
        "summary": "List of team members visible to the caller",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0, "minimum": 0 } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Search by name/email (contains)" },
          { "name": "deptId", "in": "query", "schema": { "type": "integer" }, "description": "Filter by department id" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TeamMember" } },
                "example": [
                  {
                    "id": 3,
                    "firstName": "Admin",
                    "lastName": "User",
                    "email": "admin@weroster.local",
                    "phone": "+610000000",
                    "isManager": true,
                    "status": "ACTIVE",
                    "designationName": "Registered Nurse",
                    "designationCode": "RN1",
                    "designationMatrix": "RN-4",
                    "departments": [
                      { "deptId": 4, "name": "Intensive Care Unit", "isPrimary": true }
                    ],
                    "nextShift": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "code": "BAD_REQUEST", "message": "Invalid query parameter." }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "code": "UNAUTHORIZED", "message": "Missing or invalid token" }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "code": "FORBIDDEN", "message": "Not allowed" }
              }
            }
          }
        }
      }
    },
    "/open-shifts/compare": {
      "get": {
        "operationId": "compareOpenShifts",
        "summary": "Compare open shifts between two windows",
        "parameters": [
          { "name": "fromA", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "toA",   "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "fromB", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "toB",   "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "deptId","in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OpenShiftCompareResult" }
              }
            }
          },
          "400": { "description": "Bad Request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },


  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        }
      },
      "TeamMember": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "isManager": { "type": "boolean" },
          "status": { "type": "string", "description": "ACTIVE/INACTIVE/etc." },
          "designationName": { "type": "string", "nullable": true },
          "designationCode": { "type": "string", "nullable": true },
          "designationMatrix": { "type": "string", "nullable": true },
          "departments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DeptRef" }
          },
          "nextShift": { "$ref": "#/components/schemas/ShiftPreview" }
        },
        "required": ["id", "firstName", "lastName", "email", "isManager", "status", "departments"]
      },
      "DeptRef": {
        "type": "object",
        "properties": {
          "deptId": { "type": "integer" },
          "name": { "type": "string" },
          "isPrimary": { "type": "boolean" }
        },
        "required": ["deptId", "name", "isPrimary"]
      },
      "ShiftPreview": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": { "type": "integer" },
          "startTs": { "type": "string", "format": "date-time" },
          "endTs": { "type": "string", "format": "date-time" },
          "locationId": { "type": "integer", "nullable": true },
          "locationName": { "type": "string", "nullable": true }
        },
        "required": ["id", "startTs", "endTs"]
      },
      "TeamSummary": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "active": { "type": "integer" },
          "managers": { "type": "integer" }
        },
        "required": ["total", "active", "managers"]
      },
      "OpenShiftDetail": {
        "type": "object",
        "properties": {
          "shiftId": { "type": "integer" },
          "startTs": { "type": "string", "format": "date-time" },
          "endTs": { "type": "string", "format": "date-time" },
          "deptId": { "type": "integer" },
          "locationId": { "type": "integer" },
          "code": { "type": "string" },
          "dateMade": { "type": "string", "format": "date-time" }
        },
        "required": ["shiftId", "startTs", "endTs"]
      },
      "OpenShiftCompareResult": {
        "type": "object",
        "properties": {
          "newShifts":       { "type": "array", "items": { "$ref": "#/components/schemas/OpenShiftDetail" } },
          "removedShifts":   { "type": "array", "items": { "$ref": "#/components/schemas/OpenShiftDetail" } },
          "unchangedShifts": { "type": "array", "items": { "$ref": "#/components/schemas/OpenShiftDetail" } }
        },
        "required": ["newShifts", "removedShifts", "unchangedShifts"]
      }

    }

  }
}
