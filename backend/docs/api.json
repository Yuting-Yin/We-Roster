    "/api/v1/myroster/shift/{shiftId}": {
      "get": {
        "summary": "Get shift details for the current user",
        "operationId": "getShiftDetails",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shift details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShiftDetailsDto"
                },
                "examples": {
                  "example": {
                    "value": {
                      "date": "2025-05-12",
                      "shiftId": 99003,
                      "startTime": "19:00",
                      "endTime": "22:00",
                      "durationMinutes": 180,
                      "location": {
                        "campus": "PMCC",
                        "address": null,
                        "room": null
                      },
                      "designation": "Anaes Coordinator",
                      "coworkers": [
                        {
                          "staffId": 2,
                          "staffName": "Alice Brown",
                          "staffInitials": "AB"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Shift not found or not assigned to user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/myroster/leave-request": {
      "post": {
        "summary": "Create or update a leave request for the current user",
        "description": "当前登录用户为指定班次创建或更新请假申请（年假/病假/等）。",
        "tags": [
          "LeaveRequest"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shiftId": {
                    "type": "integer",
                    "example": 99003
                  },
                  "leaveType": {
                    "type": "string",
                    "enum": [
                      "Annual",
                      "Sick",
                      "Casual",
                      "Unpaid",
                      "Other"
                    ],
                    "example": "Annual"
                  },
                  "allDay": {
                    "type": "boolean",
                    "example": false
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "example": "2025-05-12"
                  },
                  "startTime": {
                    "type": "string",
                    "format": "time",
                    "example": "09:00"
                  },
                  "endTime": {
                    "type": "string",
                    "format": "time",
                    "example": "17:00"
                  }
                },
                "required": [
                  "shiftId",
                  "leaveType",
                  "allDay",
                  "date"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leave request successfully created or updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaveRequestDto"
                },
                "example": {
                  "shiftId": 99003,
                  "leaveType": "Annual",
                  "allDay": false,
                  "date": "2025-05-12",
                  "startTime": "09:00",
                  "endTime": "17:00"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/myroster/shift/{shiftId}/swap": {
      "get": {
        "summary": "Get data for Swap Shift page",
        "description": "返回当前登录用户在指定班次的基本信息（mine）以及可互换候选人列表（search）。",
        "tags": [
          "SwapShift"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 99003
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "可选：按候选人姓名/工号关键字搜索",
            "schema": {
              "type": "string"
            },
            "example": "alice"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "分页页码（从1开始）",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "分页大小",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Swap Shift 页面数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwapShiftResponse"
                },
                "example": {
                  "mine": {
                    "shiftId": 99003,
                    "initials": "AP",
                    "date": "2025-05-12",
                    "startTime": "19:00",
                    "endTime": "22:00",
                    "campus": "Emergency Department",
                    "location": "Ward A"
                  },
                  "search": {
                    "total": 2,
                    "items": [
                      {
                        "staffId": 10021,
                        "staffName": "Alice Park",
                        "initials": "AP",
                        "startTime": "19:00",
                        "endTime": "22:00",
                        "campus": "Emergency Department",
                        "location": "Ward A"
                      },
                      {
                        "staffId": 10034,
                        "staffName": "Bob Chen",
                        "initials": "BC",
                        "startTime": "18:30",
                        "endTime": "22:30",
                        "campus": "Emergency Department",
                        "location": "Ward A"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Shift not found or not assigned to current user"
          }
        }
      }
    }, "/api/v1/myroster/shift/{shiftId}/leave-request/submit": {
      "post": {
        "summary": "Submit a leave request for the given shift",
        "tags": ["Leave"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 99003
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateLeaveRequestCommand" },
              "examples": {
                "allDay": {
                  "summary": "All-day annual leave",
                  "value": {
                    "leaveType": "Annual",
                    "allDay": true,
                    "date": "2025-09-20"
                  }
                },
                "partialDay": {
                  "summary": "Partial sick leave",
                  "value": {
                    "leaveType": "Sick",
                    "allDay": false,
                    "date": "2025-09-20",
                    "startTime": "13:00",
                    "endTime": "17:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubmissionResponse" },
                "examples": {
                  "success": {
                    "summary": "Submission successful → pending",
                    "value": {
                      "result": "success",
                      "code": "PENDING",
                      "message": "Submission accepted and pending approval.",
                      "data": { "shiftId": 99003, "leaveType": "Annual" }
                    }
                  },
                  "duplicate": {
                    "summary": "Submission unsuccessful → duplicated request",
                    "value": {
                      "result": "error",
                      "code": "DUPLICATE_REQUEST",
                      "message": "You already have an open leave request for this shift."
                    }
                  },
                  "validation": {
                    "summary": "Submission unsuccessful → validation problem",
                    "value": {
                      "result": "error",
                      "code": "VALIDATION_ERROR",
                      "message": "Missing required fields: shiftId/leaveType/date."
                    }
                  },
                  "session": {
                    "summary": "Submission unsuccessful → session expired",
                    "value": {
                      "result": "error",
                      "code": "SESSION_EXPIRED",
                      "message": "Login required."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/myroster/shift/{shiftId}/swap/submit": {
      "post": {
        "summary": "Submit a swap request for the given shift",
        "tags": [
          "Swap"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 99003
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwapSubmitCommand"
              },
              "example": {
                "targetStaffId": 3,
                "targetShiftId": 99005
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Submission successful → pending",
                    "value": {
                      "result": "success",
                      "code": "PENDING",
                      "message": "Submission accepted and pending approval.",
                      "data": {
                        "requesterShiftId": 99003,
                        "targetStaffId": 3,
                        "targetShiftId": 99005
                      }
                    }
                  },
                  "duplicate": {
                    "summary": "Submission unsuccessful → duplicated request",
                    "value": {
                      "result": "error",
                      "code": "DUPLICATE_REQUEST",
                      "message": "A pending swap request already exists for these shifts."
                    }
                  },
                  "validation": {
                    "summary": "Submission unsuccessful → validation problem",
                    "value": {
                      "result": "error",
                      "code": "VALIDATION_ERROR",
                      "message": "Target staff is not assigned to the target shift."
                    }
                  },
                  "session": {
                    "summary": "Submission unsuccessful → session expired",
                    "value": {
                      "result": "error",
                      "code": "SESSION_EXPIRED",
                      "message": "Login required."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/myroster/shift/{shiftId}/request/submit": {
      "post": {
        "summary": "Submit a request for an unallocated shift",
        "tags": ["ShiftRequest"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 99006
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftRequestSubmitCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubmissionResponse" },
                "examples": {
                  "success": {
                    "summary": "Submission successful → pending",
                    "value": {
                      "result": "success",
                      "code": "PENDING",
                      "message": "Submission accepted and pending approval.",
                      "data": { "shiftId": 99006 }
                    }
                  },
                  "duplicate": {
                    "summary": "Duplicate request",
                    "value": {
                      "result": "error",
                      "code": "DUPLICATE_REQUEST",
                      "message": "You already have a pending request for this shift."
                    }
                  },
                  "validation": {
                    "summary": "Validation problem",
                    "value": {
                      "result": "error",
                      "code": "VALIDATION_ERROR",
                      "message": "Shift is not unallocated."
                    }
                  },
                  "session": {
                    "summary": "Session expired",
                    "value": {
                      "result": "error",
                      "code": "SESSION_EXPIRED",
                      "message": "Login required."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },


  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        }
      },
      "CalendarDay": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date", "example": "2025-05-12" },
          "assignedAM": { "type": "boolean", "example": true },
          "assignedPM": { "type": "boolean", "example": false },
          "isToday": { "type": "boolean", "example": false }
        }
      },

      "ShiftItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 99003 },
          "startTs": { "type": "string", "description": "ISO local datetime", "example": "2025-05-12T19:00" },
          "endTs": { "type": "string", "description": "ISO local datetime", "example": "2025-05-12T22:00" },
          "dept": { "type": "string", "nullable": true },
          "location": { "type": "string", "nullable": true },
          "code": { "type": "string", "example": "AM-DEMO" },
          "coworkers": { "type": "integer", "example": 0 },
          "lead": { "type": "boolean", "example": false }
        }
      },

      "DayRoster": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "shifts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ShiftItem" }
          }
        }
      },

      "DayWindow": {
        "type": "object",
        "properties": {
          "startTime": { "type": "string", "example": "08:00" },
          "endTime": { "type": "string", "example": "23:59" }
        }
      },
      "Campus": {
        "type": "object",
        "properties": {
          "campusId": { "type": "string", "example": "camp_1" },
          "name": { "type": "string", "example": "Main Campus" }
        }
      },
      "LocationObj": {
        "type": "object",
        "properties": {
          "campus": { "$ref": "#/components/schemas/Campus" },
          "address": { "type": "string", "nullable": true, "example": null }
        }
      },
      "AllocatedItem": {
        "type": "object",
        "properties": {
          "shiftId": { "type": "string", "example": "sh_99003" },
          "startTime": { "type": "string", "example": "19:00" },
          "endTime": { "type": "string", "example": "22:00" },
          "durationMinutes": { "type": "integer", "example": 180 },
          "location": { "$ref": "#/components/schemas/LocationObj" },
          "designation": { "type": "string", "nullable": true, "example": "Anaes Coordinator" },
          "coworkerCount": { "type": "integer", "example": 0 }
        }
      },
      "UnallocatedItem": {
        "type": "object",
        "properties": {
          "startTime": { "type": "string", "example": "08:00" },
          "endTime": { "type": "string", "example": "19:00" },
          "label": { "type": "string", "example": "Unallocated" }
        }
      },
      "DayView": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "dayWindow": { "$ref": "#/components/schemas/DayWindow" },
          "allocated": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AllocatedItem" }
          },
          "unallocated": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UnallocatedItem" }
          }
        }
      },
      "ShiftDetailsDto": {
        "type": "object",
        "required": ["date", "shiftId", "startTime", "endTime", "durationMinutes", "location", "coworkers"],
        "properties": {
          "date": { "type": "string", "format": "date", "example": "2025-05-12" },
          "shiftId": { "type": "integer", "format": "int64", "example": 99003 },
          "startTime": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "example": "13:00" },
          "endTime": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "example": "18:00" },
          "durationMinutes": { "type": "integer", "minimum": 0, "example": 300 },
          "location": { "$ref": "#/components/schemas/LocationDto" },
          "designation": { "type": "string", "nullable": true, "example": "Anaes Coordinator" },
          "coworkers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CoworkerDto" }
          }
        }
      },
      "LocationDto": {
        "type": "object",
        "required": ["campus"],
        "properties": {
          "campus": { "type": "string", "nullable": true, "example": "PMCC" },
          "address": { "type": "string", "nullable": true, "example": null },
          "room": { "type": "string", "nullable": true, "example": null }
        }
      },
      "CoworkerDto": {
        "type": "object",
        "required": ["staffId", "staffName", "staffInitials"],
        "properties": {
          "staffId": { "type": "integer", "format": "int64", "example": 2 },
          "staffName": { "type": "string", "example": "Alice Brown" },
          "staffInitials": { "type": "string", "example": "AB" }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        },
        "additionalProperties": true
      },
      "LeaveRequestDto": {
        "type": "object",
        "properties": {
          "shiftId": { "type": "integer" },
          "leaveType": { "type": "string" },
          "allDay": { "type": "boolean" },
          "date": { "type": "string", "format": "date" },
          "startTime": { "type": "string", "format": "time" },
          "endTime": { "type": "string", "format": "time" }
        }
      },
      "SwapShiftResponse": {
        "type": "object",
        "properties": {
          "mine": { "$ref": "#/components/schemas/SwapShiftMineDto" },
          "search": { "$ref": "#/components/schemas/SwapShiftSearchSection" }
        },
        "required": ["mine", "search"]
      },
      "SwapShiftMineDto": {
        "type": "object",
        "properties": {
          "shiftId": { "type": "integer" },
          "initials": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "startTime": { "type": "string", "format": "time" },
          "endTime": { "type": "string", "format": "time" },
          "campus": { "type": "string" },
          "location": { "type": "string" }
        },
        "required": ["shiftId", "initials", "date", "startTime", "endTime"]
      },
      "SwapShiftSearchSection": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SwapCandidateItem" }
          }
        },
        "required": ["total", "items"]
      },
      "SwapCandidateItem": {
        "type": "object",
        "properties": {
          "staffId": { "type": "integer" },
          "staffName": { "type": "string" },
          "initials": { "type": "string" },
          "startTime": { "type": "string", "format": "time" },
          "endTime": { "type": "string", "format": "time" },
          "campus": { "type": "string" },
          "location": { "type": "string" }
        },
        "required": ["staffId", "staffName", "initials", "startTime", "endTime"]
      },
      "CreateLeaveRequestCommand": {
        "type": "object",
        "required": ["leaveType", "allDay", "date"],
        "properties": {
          "leaveType": {
            "type": "string",
            "description": "Annual | Sick | Casual | Unpaid | Other",
            "example": "Annual"
          },
          "allDay": { "type": "boolean", "example": true },
          "date": { "type": "string", "format": "date", "example": "2025-09-20" },
          "startTime": { "type": "string", "format": "time", "example": "09:00" },
          "endTime": { "type": "string", "format": "time", "example": "17:00" }
        }
      },
      "SwapSubmitCommand": {
        "type": "object",
        "required": ["targetStaffId", "targetShiftId"],
        "properties": {
          "targetStaffId": { "type": "integer", "example": 3 },
          "targetShiftId": { "type": "integer", "example": 99005 }
        }
      },
      "SubmissionResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "enum": ["success", "error"] },
          "code": {
            "type": "string",
            "enum": ["PENDING", "DUPLICATE_REQUEST", "VALIDATION_ERROR", "SESSION_EXPIRED"]
          },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          }
        },
        "example": {
          "result": "success",
          "code": "PENDING",
          "message": "Submission accepted and pending approval.",
          "data": { "shiftId": 99003, "leaveType": "Annual" }
        }
      },
      "ShiftRequestSubmitCommand": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500,
            "example": "I can take this unallocated shift."
          }
        }
      }
    },


    "responses": {
      "UnauthorizedError": {
        "description": "Unauthorized",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },

    "parameters": {
      "DateParam": {
        "name": "date",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "format": "date" },
        "description": "YYYY-MM-DD"
      },
      "StartParam": {
        "name": "start",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "format": "date" },
        "description": "Start date (YYYY-MM-DD)"
      },
      "MonthsParam": {
        "name": "months",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 1, "minimum": 1 },
        "description": "Number of months to include"
      }
    }
  }
}
